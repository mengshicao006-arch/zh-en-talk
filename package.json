{
  "name": "zh-en-talk",
  "version": "1.0.0",
  "private": true,
  "description": "中英实时语音互译工具，支持 Windows 与手机远程使用",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  }
}
